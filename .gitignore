/src/neuswc/
/src/neuwld/

# Generated wayland-scanner sources
/src/charabar/build/

# Binaries
/src/charabar/charabar
/src/charawc/charawc
/src/charawc/charactl

# Compiler leftovers
*.o
*.a
*.so
*.so.*
*.d
*.gcda
*.gcno
core

# Editor / OS noise
*.swp
*~
.DS_Store
